# ═══════════════════════════════════════════════════════════════════
#  学科助教系统 (Edu-TA) — 环境变量配置
# ═══════════════════════════════════════════════════════════════════

# LLM 配置（支持所有兼容 OpenAI API 的大模型）
# 讯飞星火: https://spark-api-open.xf-yun.com/v1
# DeepSeek: https://api.deepseek.com
# OpenAI:   https://api.openai.com/v1
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# Embedding 模型
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5

# 向量数据库路径
VECTOR_DB_PATH=./knowledge_base/vector_store

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 数据库 — 云端 PostgreSQL（与项目11共用 tiaozhanbei 数据库）
# PostgreSQL: postgresql+psycopg2://user:pass@host:5432/dbname
# SQLite:     sqlite:///./app.db
DATABASE_URL=postgresql+psycopg2://app_user:123456@113.45.66.152:5432/tiaozhanbei

# 项目互通标识（多项目共享数据库时用于区分数据来源）
PROJECT_ID=ta-project
PROJECT_TOKEN=
