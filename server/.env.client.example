# ─── 客户端环境变量（助教端 / 助学端通用） ──────────────────
# 复制为项目根目录下的 .env.client 并修改

# 服务器地址和密码（云端 PostgreSQL，与项目11共用）
DB_HOST=113.45.66.152
DB_PASSWORD=123456

# 项目标识（助教端: ta-project / 助学端: student-project）
PROJECT_ID=ta-project
PROJECT_TOKEN=

# LLM 配置（可选，也可在浏览器 UI 中配置）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
